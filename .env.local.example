ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model chain. Defaults shown below.
# Same provider, same credential — this protects against model-level
# unavailability (overload, per-model rate limits), not an Anthropic-wide
# outage or an invalid key.
# ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
# ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5-20251001
